# --- Espace équipe (/admin) ---
ADMIN_PASSWORD=change-moi
ADMIN_SECRET=une-longue-phrase-secrete

# --- Base de données (Supabase) ---
# Sans ces deux lignes, le site écrit dans un fichier local : bon pour tester,
# pas pour la mise en ligne. Schéma à installer : supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notification de l'équipe à chaque réservation ---
# E-mail (compte gratuit sur resend.com) :
RESEND_API_KEY=
TEAM_EMAIL=
# Facultatif : expéditeur vérifié chez Resend, ex. "OCD Live <live@ton-domaine.com>"
TEAM_EMAIL_FROM=
# Facultatif : webhook Slack / Discord / Make
TEAM_WEBHOOK_URL=

# --- Contact affiché sur le site ---
# Numéro WhatsApp officiel, format international sans « + ». Ex. 22890000000
NEXT_PUBLIC_TEAM_WHATSAPP=
